          "perl -MFindBin -MGetopt::Long -e 'print qq(ok\\n)' | grep -Fx ok >/dev/null",
          "mkdir -p /tmp/taf-fastqc-smoke/out && cd /tmp/taf-fastqc-smoke && printf '@r1\\nACGTACGTACGTACGTACGTACGT\\n+\\nFFFFFFFFFFFFFFFFFFFFFFFF\\n@r2\\nTGCATGCATGCATGCATGCATGCA\\n+\\nFFFFFFFFFFFFFFFFFFFFFFFF\\n' > reads.fq && fastqc --quiet --outdir out reads.fq && test -s out/reads_fastqc.html && test -s out/reads_fastqc.zip && unzip -p out/reads_fastqc.zip reads_fastqc/summary.txt | grep -F 'Basic Statistics' >/dev/null",
          "mkdir -p /tmp/taf-fastqc-gzip && cd /tmp/taf-fastqc-gzip && printf '@r1\\nACGTACGTACGTACGTACGTACGT\\n+\\nFFFFFFFFFFFFFFFFFFFFFFFF\\n' > reads.fq && gzip -c reads.fq > reads.fastq.gz && mkdir -p gzout && fastqc --quiet --outdir gzout reads.fastq.gz && test -s gzout/reads_fastqc.html && test -s gzout/reads_fastqc.zip",
          "mkdir -p /tmp/taf-fastqc-bzip2 && cd /tmp/taf-fastqc-bzip2 && printf '@r1\\nACGTACGTACGTACGTACGTACGT\\n+\\nFFFFFFFFFFFFFFFFFFFFFFFF\\n' > reads.fq && bzip2 -c reads.fq > reads.fastq.bz2 && mkdir -p bzout && fastqc --quiet --outdir bzout reads.fastq.bz2 && test -s bzout/reads_fastqc.html && test -s bzout/reads_fastqc.zip",
          "mkdir -p /tmp/taf-fastqc-sam && cd /tmp/taf-fastqc-sam && printf '@HD\\tVN:1.0\\tSO:unsorted\\n@SQ\\tSN:chr1\\tLN:1000\\nr1\\t0\\tchr1\\t1\\t60\\t24M\\t*\\t0\\t0\\tACGTACGTACGTACGTACGTACGT\\tFFFFFFFFFFFFFFFFFFFFFFFF\\n' > reads.sam && mkdir -p samout && fastqc --quiet --format sam --outdir samout reads.sam && test -s samout/reads_fastqc.html && test -s samout/reads_fastqc.zip",
          "mkdir -p /tmp/taf-fastqc-options && cd /tmp/taf-fastqc-options && printf '@r1\\nACGTACGTACGTACGTACGTACGT\\n+\\nFFFFFFFFFFFFFFFFFFFFFFFF\\n@r2\\nTGCATGCATGCATGCATGCATGCA\\n+\\nFFFFFFFFFFFFFFFFFFFFFFFF\\n' > reads.fq && printf 'Adapter1\\tACGTACGTACGT\\n' > adapters.txt && mkdir -p optout && fastqc --quiet --nogroup --svg --kmers 5 --memory 256 --threads 1 --adapters adapters.txt --outdir optout reads.fq && test -s optout/reads_fastqc.html && test -s optout/reads_fastqc.zip && unzip -l optout/reads_fastqc.zip | grep -F '.svg' >/dev/null",
          "mkdir -p /tmp/taf-fastqc-extract && cd /tmp/taf-fastqc-extract && printf '@r1\\nACGTACGTACGTACGTACGTACGT\\n+\\nFFFFFFFFFFFFFFFFFFFFFFFF\\n' > reads.fq && mkdir -p extractout && fastqc --quiet --extract --outdir extractout reads.fq && test -d extractout/reads_fastqc && test -s extractout/reads_fastqc/fastqc_data.txt"
