        "test": [
          "cuteSV --version 2>&1 | grep -Fx 'cuteSV 2.1.3' >/dev/null && cuteSV --help 2>&1 | grep -F 'Current version: v2.1.3' >/dev/null && cuteSV --help 2>&1 | grep -F 'Sorted .bam file' >/dev/null && cuteSV --help 2>&1 | grep -F 'The force calling module was disabled in cuteSV' >/dev/null",
          "python -c 'import importlib.metadata as md; assert md.version(\"cuteSV\") == \"2.1.3\"; import cuteSV, pysam, Bio, cigar, vcf, scipy, sklearn, numpy; print(\"cuteSV-runtime-ok\", md.version(\"pysam\"))' | grep -F 'cuteSV-runtime-ok' >/dev/null && samtools --version 2>&1 | grep -F 'samtools' >/dev/null && bgzip --help >/dev/null && tabix --help >/dev/null",
          "tmp=/tmp/taf-cutesv-call-$$; rm -rf \"$tmp\"; mkdir -p \"$tmp\"; python /opt/cutesv/share/testdata/make_minimal_inputs.py \"$tmp\"; cd \"$tmp\"; samtools quickcheck reads.bam; cuteSV reads.bam ref.fa calls.vcf work -t 1 -s 1 -r 50 -q 0 -l 30 --sample taf_smoke --retain_work_dir > run.log 2>&1; test -s calls.vcf; grep -F '##fileformat=VCFv4.2' calls.vcf >/dev/null; grep -F '##source=cuteSV-2.1.3' calls.vcf >/dev/null; grep -F '#CHROM' calls.vcf >/dev/null; grep -F 'SVTYPE=DEL' calls.vcf >/dev/null; rm -rf \"$tmp\"",
          "test -s /opt/cutesv/share/doc/cutesv/README.md && test -s /opt/cutesv/share/doc/cutesv/source.txt && test -s /opt/cutesv/share/licenses/cutesv/LICENSE"
